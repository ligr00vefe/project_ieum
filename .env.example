# docker-compose 환경변수 예시 — 복사해서 .env 생성 후 실제 값 입력.
#   cp .env.example .env
# .env 는 gitignored 이다.

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ieum
MYSQL_USER=ieum
MYSQL_PASSWORD=change-me-user
# 호스트 포트(컨테이너는 3306). 팀 MySQL 전환 전 스테이징은 33306 권장.
MYSQL_PORT=33306

# ===== App =====
APP_PORT=8080

# 빈 볼륨 첫 기동 시 스키마 자동생성(update). 데이터 보존 후엔 validate 권장.
DDL_AUTO=update
